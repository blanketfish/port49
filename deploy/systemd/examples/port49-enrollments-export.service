# The directory's enrollment store, exported still sealed, on a broker host. It reads the
# store with the broker's own etcd identity, so it needs no admin credential. The file is
# written 0600 (UMask=0077) into /var/backups/port49, which tmpfiles.d makes 0700 root;
# systemd itself opens StandardOutput=file:, so the unit's user needs no write there.
# Unmeasured on a real host: run it once by hand (README) before relying on the timer.
# Restore with `port49 directory import`, which needs an admin and a key press.
[Unit]
Description=port49 enrollment export

[Service]
Type=oneshot
User=port49-broker
Group=port49-broker
UMask=0077
ExecStart=/usr/bin/port49-broker export-enrollments
StandardOutput=file:/var/backups/port49/directory-export.json
