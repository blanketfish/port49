# port49-broker, the login broker (plan 12b). Installed by the port49-server package at
# /usr/lib/systemd/system/; enable it yourself: `systemctl enable --now port49-broker`.
#
# StateDirectory= makes /var/lib/port49-broker 0700 and owned by port49-broker, which is
# what broker.state_dir requires. The issuing CA key is kept there, so back this directory
# up with the host. The deliberate absences are port49d.service's.
[Unit]
Description=port49 broker
Documentation=https://github.com/rhwendt/port49
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=port49-broker
Group=port49-broker
ExecStart=/usr/bin/port49-broker --config /etc/port49/port49-broker.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
LimitNOFILE=65536
UMask=0077
StateDirectory=port49-broker
StateDirectoryMode=0700
# The broker binds 8443 and needs no capability at all.
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=true
ProtectHome=yes

[Install]
WantedBy=multi-user.target
