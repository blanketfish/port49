# port49 reference AAA configuration: Junos, TACACS+ over TLS (RFC 9887).
# Junos 26.2R1 or later on routing and switching platforms, not SRX. Measured on
# vJunos-router 26.2R1.7 (L73).
#
# Replace each angle-bracket placeholder before you load this (load set terminal).
# README.md in this directory says what each one is.
#
# Classes come from port49 platform export --classes (see juniper_junos.set).
#
# The device certificate: certificate-id <CERT_ID> is a local certificate in the PKI
# store (request security pki generate-key-pair, generate-certificate-request with
# domain-name <SERVER_NAME>, then local-certificate load). The CA profiles and a
# trusted-ca-group named port49 hold the roots that sign port49d's certificate; load
# them first or the tls trusted-ca-group line is refused (L73).
#
# authentication-order is tacplus alone, as in juniper_junos.set.
set system authentication-order tacplus
#
set security pki trusted-ca-group port49 ca-profiles port49-root
#
# A TLS server carries no secret. With no port set Junos dials 49, so the port is always set.
set system tacplus-server <PORT49_1> routing-instance <MGMT_VRF>
set system tacplus-server <PORT49_1> source-address <SOURCE_ADDRESS>
set system tacplus-server <PORT49_1> port <TLS_PORT>
set system tacplus-server <PORT49_1> tls trusted-ca-group port49
set system tacplus-server <PORT49_1> tls mutual-authentication certificate-id <CERT_ID>
set system tacplus-server <PORT49_1> single-connection
set system tacplus-server <PORT49_2> routing-instance <MGMT_VRF>
set system tacplus-server <PORT49_2> source-address <SOURCE_ADDRESS>
set system tacplus-server <PORT49_2> port <TLS_PORT>
set system tacplus-server <PORT49_2> tls trusted-ca-group port49
set system tacplus-server <PORT49_2> tls mutual-authentication certificate-id <CERT_ID>
set system tacplus-server <PORT49_2> single-connection
#
set system accounting events [ login change-log interactive-commands ]
set system accounting destination tacplus server <PORT49_1> routing-instance <MGMT_VRF>
set system accounting destination tacplus server <PORT49_1> source-address <SOURCE_ADDRESS>
set system accounting destination tacplus server <PORT49_1> port <TLS_PORT>
set system accounting destination tacplus server <PORT49_1> tls trusted-ca-group port49
set system accounting destination tacplus server <PORT49_1> tls mutual-authentication certificate-id <CERT_ID>
set system accounting destination tacplus server <PORT49_2> routing-instance <MGMT_VRF>
set system accounting destination tacplus server <PORT49_2> source-address <SOURCE_ADDRESS>
set system accounting destination tacplus server <PORT49_2> port <TLS_PORT>
set system accounting destination tacplus server <PORT49_2> tls trusted-ca-group port49
set system accounting destination tacplus server <PORT49_2> tls mutual-authentication certificate-id <CERT_ID>
#
set system login user <BREAKGLASS_USER> class super-user
