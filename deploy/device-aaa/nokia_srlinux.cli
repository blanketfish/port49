# port49 reference AAA configuration: Nokia SR Linux, TACACS+ over TCP (RFC 8907).
# There is no TLS reference for SR Linux.
#
# Replace each angle-bracket placeholder before you load this. README.md in this
# directory says what each one is.
#
# Set the break-glass account's password by hand, never in this file. The policy needs
# a platforms block for SR Linux: see policy-platforms.yaml in this directory.
#
# exit-on-reject true makes a port49 deny final. Without it a deny falls through to
# local (L76 cell d). Whether break-glass still logs in once port49d is dark is L87,
# and is unmeasured until it closes (README.md, "SR Linux").
system {
    aaa {
        authentication {
            exit-on-reject true
            authentication-method [
                port49
                local
            ]
            user <BREAKGLASS_USER> {
                role [
                    p49-admin
                ]
            }
        }
        authorization {
            # priv-lvl 1 and 15 are the two levels port49 sends. The operator level maps to
            # 1, so an operator is read-only here until a level between them is measured.
            role p49-read {
                services [ cli ]
                tacacs {
                    priv-lvl 1
                }
            }
            role p49-admin {
                services [ cli ]
                tacacs {
                    priv-lvl 15
                }
            }
        }
        accounting {
            accounting-method [
                port49
            ]
            event command {
                record start-stop
            }
        }
        server-group local {
            type local
        }
        server-group port49 {
            type tacacs
            tacacs {
                priv-lvl-authorization true
            }
            server <PORT49_1> {
                network-instance <MGMT_VRF>
                tacacs {
                    port 49
                    secret-key <KEY>
                    # source-address is unmeasured (L88): the lab config set none.
                    source-address <SOURCE_ADDRESS>
                }
            }
            server <PORT49_2> {
                network-instance <MGMT_VRF>
                tacacs {
                    port 49
                    secret-key <KEY>
                    # source-address is unmeasured (L88): the lab config set none.
                    source-address <SOURCE_ADDRESS>
                }
            }
        }
    }
    configuration {
        role p49-read {
            rule / {
                action read
            }
        }
        role p49-admin {
            rule / {
                action write
            }
        }
    }
}
