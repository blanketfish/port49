---
# Oxidized for port49 (plan 8). Measured in lab L49 (policy engine spec §15;
# tests/lab/results/L49-oxidized-<platform>.md).
# Each node's username and password come from router.db, which
# port49-oxidized-run rewrites with a fresh token per node before each run.
# Oxidized's own interval is set a week out so that its own schedule tries as
# few nodes as possible with an expired token. A try with a spent token cost one
# authentication on each platform (L49, phase B); how often Oxidized's own
# schedule still tries is not measured. port49-oxidized-run asks for each
# node's run through the REST API.
username: unused-see-router-db
password: unused-see-router-db
model: eos
resolve_dns: false
interval: 604800
use_syslog: false
debug: false
threads: 8
timeout: 30
# A failed login retried is the same token failing again: with 0, a stale
# token cost one authentication (L49, phase B).
retries: 0
rest: 127.0.0.1:8888
next_adds_job: false
vars: {}
# Oxidized's default is none, publickey, password. net-ssh skips a method the
# device does not list, and Arista EOS lists only publickey and
# keyboard-interactive (L4), so by default Oxidized never sends the token to EOS.
# keyboard-interactive is what makes it send one. Leave the device as it is.
# It is the eos model's alone: on a device that also lists password (NX-OS,
# IOS-XE), a global keyboard-interactive made one stale token cost two
# authentications instead of one (an L49 run at 0a6d546). Oxidized looks a model's vars up before
# the global ones.
models:
  eos:
    vars:
      auth_methods:
        - none
        - publickey
        - password
        - keyboard-interactive
groups: {}
input:
  default: ssh
  debug: false
  ssh:
    # Host keys are verified against ~/.ssh/known_hosts (design §17: a device
    # address is a fact from the source of truth, trusted no further than its
    # host key). Populate it once per device; never set secure: false.
    secure: true
output:
  default: git
  git:
    user: oxidized
    email: oxidized@example.com
    repo: "~/.config/oxidized/configs.git"
source:
  default: csv
  csv:
    file: "~/.config/oxidized/router.db"
    delimiter: !ruby/regexp /\t/
    map:
      name: 0
      ip: 1
      model: 2
      username: 3
      password: 4
