# Local environment
.env
.env.local

# Python bytecode (the examples' own tests)
__pycache__/
*.pyc

# Editor / OS
.DS_Store
*.swp

# Lab
#
# Raw captures hold the lab tokens and the breakglass password: obfuscated, but
# under a key this repository publishes, so they are in the clear for anyone who
# runs Wireshark. They never leave the machine that took them.
# `tests/lab/evidence/` is the redacted copy, and IS committed: it is what every
# results note points at. Do not add it here.
/tests/lab/captures/
/tests/lab/logs/
# L66's private Ansible collections (ansible-galaxy installs them; nothing is committed)
/tests/lab/l66/.collections/
# `pip install ./clients/python` writes these into the tree
/clients/python/build/
/clients/python/src/*.egg-info/
# containerlab's per-lab working directory, created beside the topology it runs
/tests/lab/topologies/clab-*/
# deploy/compose's trial PKI and secret files (go run ./tests/compose/cmd/compose-pki)
/deploy/compose/local/
/cmd/port49/port49
