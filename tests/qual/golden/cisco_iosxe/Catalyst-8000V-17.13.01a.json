{
  "pending_lab": false,
  "scenarios": {
    "single_connection": {
      "outcome": "login_ok",
      "steps": [
        {
          "step": "login",
          "event": "authen_pass"
        },
        {
          "step": "authorize_session",
          "event": "author_pass_add",
          "args": [
            "priv-lvl=15"
          ]
        },
        {
          "step": "command_permitted",
          "event": "author_pass_add"
        },
        {
          "step": "command_denied",
          "event": "author_fail"
        },
        {
          "step": "account_start",
          "event": "acct_success"
        },
        {
          "step": "account_stop",
          "event": "acct_success"
        }
      ]
    },
    "store_unavailable": {
